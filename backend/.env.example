DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/capresol
IDEALISTA_API_KEY=your_api_key_here
IDEALISTA_SECRET=your_secret_here
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Auth
JWT_SECRET=change-this-to-a-random-32-char-string
# JSON array of users to seed on first run
USERS_CONFIG=[{"username":"user1","password":"pass1"},{"username":"user2","password":"pass2"}]

# CORS — comma-separated list of allowed origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
